---
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { JOBS } from '../data/jobs';
import { AUTHOR, GITHUB_URL, LINKEDIN_URL, SITE_URL } from '../data/site';
import { getLocale, LOCALES, t } from '../i18n';
import { DEFAULT_THEME, THEME_STORAGE_KEY } from '../lib/theme';

interface Props {
  title?: string;
  description?: string;
}

const locale = getLocale();
const siteName = t(locale, 'site.name');
const title = Astro.props.title
  ? `${Astro.props.title} · ${siteName}`
  : siteName;
const description = Astro.props.description ?? t(locale, 'site.description');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og.png', Astro.site);
const alternateLocales = LOCALES.filter((other) => other !== locale);

// Structured data so a search for the name gets a proper card.
const currentJob = JOBS.find((job) => job.to === undefined);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR,
  url: SITE_URL,
  jobTitle: t(locale, 'hero.role'),
  ...(currentJob && {
    worksFor: { '@type': 'Organization', name: currentJob.company },
  }),
  sameAs: [GITHUB_URL, LINKEDIN_URL],
};
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={locale} />
    {
      alternateLocales.map((other) => (
        <meta property="og:locale:alternate" content={other} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <script
      is:inline
      define:vars={{
        storageKey: THEME_STORAGE_KEY,
        defaultTheme: DEFAULT_THEME,
      }}
    >
      // Runs before first paint so the stored theme never flashes.
      let theme = defaultTheme;
      try {
        const stored = localStorage.getItem(storageKey);
        if (stored === 'light' || stored === 'dark') {
          theme = stored;
        }
      } catch {
        /* storage unavailable — keep the default */
      }
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body
    class="bg-surface text-ink flex min-h-dvh flex-col font-sans antialiased"
  >
    <a
      href="#content"
      class="focus:bg-accent focus:text-surface sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-20 focus:rounded-md focus:px-3 focus:py-2"
    >
      {t(locale, 'skip.content')}
    </a>
    <Header />
    <main id="content" class="mx-auto w-full max-w-5xl flex-1 px-4 sm:px-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
