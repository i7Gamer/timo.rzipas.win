---
import PathHeading from '../components/PathHeading.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TerminalLine from '../components/TerminalLine.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { MACHINES } from '../data/hardware';
import { SERVICES } from '../data/services';
import { getLocale, t, type UIKey } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

const locale = getLocale();

const DIAGRAM_STEPS: readonly UIKey[] = [
  'diagram.visitor',
  'diagram.cloudflare',
  'diagram.tunnel',
  'diagram.nginx',
  'diagram.site',
];
---

<BaseLayout title={t(locale, 'homelab.title')}>
  <section class="py-10">
    <header class="mb-10">
      <PathHeading path="homelab" />
      <p class="text-muted mt-4">{t(locale, 'homelab.intro')}</p>
    </header>

    <div class="space-y-10">
      <div>
        <SectionHeading>{t(locale, 'homelab.hardware.title')}</SectionHeading>
        <div class="mt-6 grid items-start gap-6 lg:grid-cols-2">
          {
            MACHINES.map((machine) => (
              <div>
                <h3 class="text-muted mb-2 font-mono text-sm">
                  {t(locale, machine.titleKey)}
                </h3>
                <TerminalWindow title={machine.terminalTitle}>
                  <TerminalLine cmd="fastfetch" />
                  {machine.specs.map((spec) => (
                    <p class="flex flex-wrap gap-x-2">
                      <span class="text-accent w-36 shrink-0">
                        {t(locale, spec.labelKey)}
                      </span>
                      <span class="text-ink">
                        {spec.valueKey ? t(locale, spec.valueKey) : spec.value}
                      </span>
                    </p>
                  ))}
                </TerminalWindow>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <SectionHeading>{t(locale, 'homelab.diagram.title')}</SectionHeading>
        <ol class="mx-auto mt-6 flex max-w-xs flex-col items-center">
          {
            DIAGRAM_STEPS.map((step, index) => (
              <li class="flex w-full flex-col items-center">
                {index > 0 && (
                  <span aria-hidden="true" class="text-accent py-1 font-mono">
                    ↓
                  </span>
                )}
                <span class="panel-sm text-ink w-full px-3 py-2 text-center font-mono text-xs">
                  {t(locale, step)}
                </span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="panel-lg">
        <SectionHeading>{t(locale, 'homelab.why.title')}</SectionHeading>
        <p class="text-muted mt-4">{t(locale, 'homelab.why.text')}</p>
      </div>

      <div>
        <div
          class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2"
        >
          <SectionHeading>{t(locale, 'homelab.services.title')}</SectionHeading>
          <p class="text-muted font-mono text-xs">
            {t(locale, 'homelab.services.note')}{' '}
            <span data-status-asof data-label={t(locale, 'status.asOf')} hidden
            ></span>
          </p>
        </div>
        <div
          class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
          data-status-grid
          data-label-online={t(locale, 'status.online')}
          data-label-offline={t(locale, 'status.offline')}
        >
          {
            SERVICES.map((service) => (
              <ServiceCard service={service} locale={locale} />
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { loadLiveStatus } from '../lib/live-status';

  const grid = document.querySelector('[data-status-grid]');
  const asOf = document.querySelector('[data-status-asof]');
  if (grid instanceof HTMLElement) {
    // Fire and forget — without status.json the build-time labels remain.
    loadLiveStatus(grid, asOf instanceof HTMLElement ? asOf : null).catch(
      () => {},
    );
  }
</script>
