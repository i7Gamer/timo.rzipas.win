---
import PathHeading from '../components/PathHeading.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceGroups from '../components/ServiceGroups.astro';
import TerminalLine from '../components/TerminalLine.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { MACHINES } from '../data/hardware';
import { getLocale, t, type UIKey } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { specLines } from '../lib/spec';

const locale = getLocale();

const DIAGRAM_STEPS: readonly UIKey[] = [
  'diagram.visitor',
  'diagram.cloudflare',
  'diagram.tunnel',
  'diagram.nginx',
  'diagram.site',
];
---

<BaseLayout
  title={t(locale, 'homelab.title')}
  description={t(locale, 'homelab.intro')}
>
  <section class="py-10">
    <header class="mb-10">
      <PathHeading path="homelab" />
      <p data-ask-overview class="text-muted mt-4 max-w-3xl text-lg">
        {t(locale, 'homelab.intro')}
      </p>
    </header>

    <div class="space-y-16">
      <div>
        <SectionHeading>{t(locale, 'homelab.hardware.title')}</SectionHeading>
        <div
          data-hardware-row
          role="region"
          aria-label={t(locale, 'homelab.hardware.title')}
          class="-mx-4 mt-6 flex snap-x snap-mandatory items-start gap-6 overflow-x-auto scroll-px-4 px-4 pb-3 sm:-mx-6 sm:scroll-px-6 sm:px-6 lg:mx-0 lg:grid lg:grid-cols-3 lg:overflow-visible lg:px-0 lg:pb-0"
        >
          {MACHINES.map((machine) => (
            <div class="w-[85%] snap-start shrink-0 sm:w-[60%] lg:w-auto">
              <h3 class="text-ink font-mono text-sm font-semibold">
                {t(locale, machine.titleKey)}
              </h3>
              <p class="text-muted mb-3 text-sm">
                {t(locale, machine.roleKey)}
              </p>
              <TerminalWindow title={machine.terminalTitle}>
                <TerminalLine cmd="fastfetch" />
                {machine.specs.map((spec) => (
                  <p class="grid gap-x-2 grid-cols-[6rem_minmax(0,1fr)]">
                    <span class="text-accent">{t(locale, spec.labelKey)}</span>
                    <span class="text-ink min-w-0 break-words">
                      {specLines(
                        spec.valueKey
                          ? t(locale, spec.valueKey)
                          : (spec.value ?? ''),
                      ).map((line) => (
                        <span class="block">{line}</span>
                      ))}
                    </span>
                  </p>
                ))}
              </TerminalWindow>
            </div>
          ))}
        </div>
      </div>

      <div class="grid items-start gap-10 lg:grid-cols-2">
        <div>
          <SectionHeading>{t(locale, 'homelab.diagram.title')}</SectionHeading>
          <ol class="mx-auto mt-6 flex max-w-xs flex-col items-center">
            {DIAGRAM_STEPS.map((step, index) => (
              <li class="flex w-full flex-col items-center">
                {index > 0 && (
                  <span aria-hidden="true" class="text-accent py-1 font-mono">
                    ↓
                  </span>
                )}
                <span class="panel-sm text-ink w-full px-3 py-2 text-center font-mono text-xs">
                  {t(locale, step)}
                </span>
              </li>
            ))}
          </ol>
        </div>

        <div class="panel-lg self-start">
          <SectionHeading>{t(locale, 'homelab.why.title')}</SectionHeading>
          <p data-ask-overview class="text-muted mt-4">
            {t(locale, 'homelab.why.text')}
          </p>
        </div>
      </div>

      <div>
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <SectionHeading>{t(locale, 'homelab.services.title')}</SectionHeading>
          <p class="text-muted font-mono text-xs">
            {t(locale, 'homelab.services.note')}{' '}
            <span
              data-status-asof
              data-label={t(locale, 'status.asOf')}
              hidden
            ></span>
          </p>
        </div>
        <ServiceGroups locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { startLiveStatus } from '../lib/live-status';

  const grid = document.querySelector('[data-status-grid]');
  const asOf = document.querySelector('[data-status-asof]');
  if (grid instanceof HTMLElement) {
    startLiveStatus(grid, asOf instanceof HTMLElement ? asOf : null);
  }
</script>
