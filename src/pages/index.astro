---
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TerminalLine from '../components/TerminalLine.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { RAM_TOTAL, STORAGE_TOTAL } from '../data/hardware';
import { PROJECTS } from '../data/projects';
import { pageHref } from '../data/routes';
import { SERVICES } from '../data/services';
import { getLocale, t, type UIKey } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredProjects } from '../lib/projects';

const locale = getLocale();
const featured = featuredProjects(PROJECTS);

const STATS: ReadonlyArray<{ value: string; labelKey: UIKey }> = [
  { value: STORAGE_TOTAL, labelKey: 'stats.storage' },
  { value: RAM_TOTAL, labelKey: 'stats.ram' },
  { value: '24/7', labelKey: 'stats.uptime' },
  { value: `${SERVICES.length}+`, labelKey: 'stats.services' },
];

// Outputs for the interactive terminal — read by the <script> below.
const TERMINAL_STRINGS = {
  whoami: t(locale, 'terminal.whoami.out'),
  skills: t(locale, 'terminal.skills.out'),
  health: t(locale, 'terminal.health.out'),
  help: t(locale, 'terminal.help.out'),
  sudo: t(locale, 'terminal.sudo.out'),
};
---

<BaseLayout>
  <section class="bg-dots relative -mx-4 px-4 py-16 sm:-mx-6 sm:px-6 lg:py-24">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div class="space-y-5">
        <p class="text-accent font-mono text-sm">
          {t(locale, 'hero.role')} · {t(locale, 'hero.location')}
        </p>
        <h1 class="text-ink text-4xl font-bold tracking-tight sm:text-5xl">
          {t(locale, 'hero.greeting')}
        </h1>
        <p class="text-ink text-lg font-medium">{t(locale, 'hero.tagline')}</p>
        <p class="text-muted">{t(locale, 'hero.intro')}</p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href={pageHref('projects')} class="btn-primary">
            {t(locale, 'hero.cta.projects')}
          </a>
          <a href={pageHref('homelab')} class="btn-muted">
            {t(locale, 'hero.cta.homelab')}
          </a>
        </div>
      </div>
      <div
        data-hero-terminal
        data-strings={JSON.stringify(TERMINAL_STRINGS)}
        data-input-label={t(locale, 'terminal.input.label')}
        class="min-w-0"
      >
        <TerminalWindow title={t(locale, 'terminal.title')}>
          <TerminalLine
            cmd={t(locale, 'terminal.whoami.cmd')}
            out={t(locale, 'terminal.whoami.out')}
          />
          <TerminalLine
            cmd={t(locale, 'terminal.skills.cmd')}
            out={t(locale, 'terminal.skills.out')}
          />
          <TerminalLine
            cmd={t(locale, 'terminal.health.cmd')}
            out={t(locale, 'terminal.health.out')}
          />
          <div data-terminal-idle>
            <TerminalLine cmd="" cursor />
          </div>
        </TerminalWindow>
      </div>
    </div>
  </section>

  <div class="space-y-10 py-10">
    <section>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading>{t(locale, 'section.featured.title')}</SectionHeading>
        <a href={pageHref('projects')} class="link-accent text-sm">
          {t(locale, 'section.featured.all')} →
        </a>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          featured.map((project) => (
            <ProjectCard project={project} locale={locale} />
          ))
        }
      </div>
    </section>

    <section>
      <div class="panel-lg">
        <SectionHeading
          >{t(locale, 'section.homelabTeaser.title')}</SectionHeading
        >
        <p class="text-muted mt-4">
          {t(locale, 'section.homelabTeaser.text')}
        </p>
        <dl class="mt-6 grid max-w-xl grid-cols-2 gap-4 sm:grid-cols-4">
          {
            STATS.map((stat) => (
              <div class="flex flex-col-reverse">
                <dt class="text-muted font-mono text-xs">
                  {t(locale, stat.labelKey)}
                </dt>
                <dd class="text-accent font-mono text-xl font-semibold">
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
        <a href={pageHref('homelab')} class="btn-accent mt-6 inline-block">
          {t(locale, 'section.homelabTeaser.cta')} →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { setUpTerminal } from '../lib/terminal-ui';

  const host = document.querySelector('[data-hero-terminal]');
  if (host instanceof HTMLElement) {
    setUpTerminal(host);
  }
</script>
