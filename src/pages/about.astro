---
import PathHeading from '../components/PathHeading.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TimelineItem from '../components/TimelineItem.astro';
import CvLinks from '../components/CvLinks.astro';
import SkillGroups from '../components/SkillGroups.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { QUALIFICATIONS } from '../data/qualifications';
import { EDUCATION } from '../data/education';
import { JOBS } from '../data/jobs';
import { SPOKEN_LANGUAGES } from '../data/skills';
import { getLocale, pick, t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPeriod } from '../lib/dates';

const locale = getLocale();
const presentLabel = t(locale, 'about.present');
---

<BaseLayout
  title={t(locale, 'about.title')}
  description={t(locale, 'about.intro')}
>
  <section class="py-10">
    <header class="mb-10">
      <PathHeading path="about" />
      <p class="text-muted mt-4 max-w-3xl text-lg">
        {t(locale, 'about.intro')}
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
        <SocialLinks locale={locale} size="lg" />
        <CvLinks locale={locale} />
      </div>
    </header>

    <div class="space-y-16">
      <div>
        <SectionHeading>{t(locale, 'about.experience.title')}</SectionHeading>
        <ol class="mt-7">
          {JOBS.map((job) => (
            <TimelineItem
              id={job.id}
              period={
                job.periodLabel
                  ? pick(locale, job.periodLabel)
                  : formatPeriod(locale, job.from, job.to, presentLabel)
              }
              highlights={job.highlights?.map((highlight) =>
                pick(locale, highlight),
              )}
              title={pick(locale, job.role)}
              org={job.company}
              orgUrl={job.url}
              location={pick(locale, job.location)}
              summary={pick(locale, job.summary)}
              detailHref={job.project?.href}
              detailLabel={
                job.project ? pick(locale, job.project.label) : undefined
              }
              tags={job.tech}
              collapsed={job.collapsed}
            />
          ))}
        </ol>
      </div>

      <div>
        <SectionHeading>{t(locale, 'about.education.title')}</SectionHeading>
        <ol class="mt-7">
          {EDUCATION.map((entry) => (
            <TimelineItem
              period={formatPeriod(locale, entry.from, entry.to, presentLabel)}
              title={pick(locale, entry.degree)}
              org={entry.school}
              orgUrl={entry.url}
            />
          ))}
        </ol>
      </div>

      <div>
        <SectionHeading>{t(locale, 'about.skills.title')}</SectionHeading>
        <div class="mt-6">
          <SkillGroups locale={locale} />
        </div>
      </div>

      <div class="grid gap-16 sm:grid-cols-2">
        <section>
          <SectionHeading>
            {t(locale, 'about.qualifications.title')}
          </SectionHeading>
          <ul class="mt-6 space-y-4">
            {QUALIFICATIONS.map((qualification) => (
              <li>
                <>
                  <h3 class="text-ink font-medium">
                    {pick(locale, qualification.title)}
                  </h3>
                  <p class="text-muted mt-1 text-base">
                    {qualification.issuer} ·{' '}
                    <time datetime={qualification.date}>
                      {new Date(
                        `${qualification.date}T00:00:00Z`,
                      ).toLocaleDateString(locale, {
                        day: 'numeric',
                        month: 'long',
                        year: 'numeric',
                        timeZone: 'UTC',
                      })}
                    </time>
                  </p>
                </>
              </li>
            ))}
          </ul>
        </section>
        <div>
          <SectionHeading>{t(locale, 'about.languages.title')}</SectionHeading>
          <ul class="mt-6 max-w-xs space-y-3">
            {SPOKEN_LANGUAGES.map((language) => (
              <li class="border-line flex justify-between gap-4 border-b pb-2 text-base">
                <span class="text-ink">{pick(locale, language.name)}</span>
                <span class="text-muted font-mono">
                  {pick(locale, language.level)}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
