---
import { getLocale, t } from '../i18n';
import { DARK_THEME, DEFAULT_THEME } from '../lib/theme';

const locale = getLocale();

// Rendered for the default theme; the inline script in BaseLayout may flip
// the class before paint, so the toggle's own script re-syncs this on load.
const pressed = DEFAULT_THEME === DARK_THEME;
---

<button
  type="button"
  data-theme-toggle
  aria-pressed={pressed}
  aria-label={t(locale, 'a11y.toggleTheme')}
  class="border-line text-muted hover:border-accent hover:text-accent grid size-9 place-items-center rounded-md border transition-colors"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="hidden size-4 dark:block"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="size-4 dark:hidden"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  import {
    applyTheme,
    currentTheme,
    DARK_THEME,
    nextTheme,
    THEME_COLORS,
    THEME_STORAGE_KEY,
  } from '../lib/theme';

  const root = document.documentElement;

  /** Keep the button's state in step with the theme actually on <html>. */
  const syncPressed = (button: Element) => {
    button.setAttribute(
      'aria-pressed',
      String(currentTheme(root) === DARK_THEME),
    );
  };

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    // The stored theme may differ from what the server rendered.
    syncPressed(button);
    button.addEventListener('click', () => {
      const next = nextTheme(currentTheme(root));
      applyTheme(root, next);
      syncPressed(button);
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', THEME_COLORS[next]);
      try {
        localStorage.setItem(THEME_STORAGE_KEY, next);
      } catch {
        // storage unavailable (private mode) — the toggle still works for this visit
      }
    });
  });
</script>
