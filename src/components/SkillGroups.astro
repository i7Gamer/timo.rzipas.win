---
import type { Locale, Localized } from '../i18n';
import { pick } from '../i18n';
import { SKILL_GROUPS } from '../data/skills';
import { renderIconSvg } from '../lib/icons';

interface Props {
  locale: Locale;
}

const ICON_SIZE_PX = 28;
const EVIDENCE_LABEL: Localized<string> = {
  en: 'Where I used it',
  de: 'Wo ich es eingesetzt habe',
};

const { locale } = Astro.props;
---

<div class="space-y-8">
  {SKILL_GROUPS.map((group) => (
    <div>
      <h3 class="text-muted font-mono text-sm">{pick(locale, group.title)}</h3>
      <ul class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6">
        {group.items.map((item) => (
          <li class="panel-sm flex flex-col items-center gap-2 px-2 py-3 text-center">
            <span
              class="text-accent"
              aria-hidden="true"
              set:html={renderIconSvg(item.icon, ICON_SIZE_PX)}
            />
            <span class="text-ink text-sm">{item.name}</span>
          </li>
        ))}
      </ul>
      {group.evidence && (
        <div class="mt-3 text-sm">
          <p class="text-muted">{pick(locale, EVIDENCE_LABEL)}</p>
          <ul class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
            {group.evidence.map((evidence) => (
              <li>
                <a href={evidence.href} class="link-accent">
                  {pick(locale, evidence.text)} →
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  ))}
</div>
