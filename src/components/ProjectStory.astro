---
import { getImage, Image } from 'astro:assets';
import { pick, t, type Locale } from '../i18n';
import {
  projectName,
  projectSources,
  type Project,
  type ProjectStoryContent,
} from '../lib/projects';
import ProjectLogo from './ProjectLogo.astro';
import { PROJECT_AI_NOTES } from '../data/project-ai';

interface Props {
  project: Project & { story: ProjectStoryContent };
  locale: Locale;
}
const { project, locale } = Astro.props;
const sources = projectSources(project, locale);
const { story } = project;
const aiNote =
  project.slug === 'hearthcoil' ? PROJECT_AI_NOTES.hearthcoil : undefined;
const sections = ['problem', 'contribution', 'decisions', 'outcome'] as const;
const contributionAnchor =
  import.meta.env.ASK_WORK_MODE !== 'off' &&
  project.slug === 'spotify-stats-tracker'
    ? 'contribution'
    : undefined;
const SCREENSHOT_WIDTHS = [480, 800, 1200];
const linkScreenshots = project.slug !== 'spotify-stats-tracker';
---

<article class="py-10">
  <a href="/projects/" class="link-accent text-sm">
    ← {t(locale, 'project.back')}
  </a>
  <header class="mt-7 max-w-3xl">
    <div class="flex items-center gap-5">
      {project.logo && <ProjectLogo logo={project.logo} size="story" />}
      <div class="min-w-0">
        <p class="text-accent font-mono text-xs">
          {t(locale, `project.status.${project.status}`)}
          {project.fork && ` · ${t(locale, 'project.status.fork')}`}
        </p>
        <h1 class="text-ink mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          {projectName(project, locale)}
        </h1>
      </div>
    </div>
    <p class="text-muted mt-4 text-lg">{pick(locale, project.tagline)}</p>
    <ul class="mt-5 flex flex-wrap gap-2">
      {project.tech.map((tech) => (
        <li class="chip bg-panel text-ink">{tech}</li>
      ))}
    </ul>
    {(sources.length > 0 || project.link) && (
      <div data-project-external class="mt-6 flex flex-wrap gap-3">
        {sources.map((source) => (
          <a
            href={source.href}
            target="_blank"
            rel="noopener"
            class="btn-muted"
          >
            {source.label}
          </a>
        ))}
        {project.link && (
          <a
            href={project.link}
            target="_blank"
            rel="noopener"
            class="btn-primary"
          >
            {t(locale, 'project.visit')}
          </a>
        )}
      </div>
    )}
  </header>
  <div class="mt-10 grid gap-8 md:grid-cols-2">
    {sections.map((section) => (
      <section
        id={section === contributionAnchor ? contributionAnchor : undefined}
      >
        <>
          <h2 class="text-ink font-mono text-lg font-semibold">
            {t(locale, `project.story.${section}`)}
          </h2>
          <p class="text-muted mt-3 leading-relaxed">
            {pick(locale, story[section])}
          </p>
        </>
      </section>
    ))}
  </div>
  {story.additionalSections?.map(({ id, title, text, links }) => (
    <section id={id} class="mt-8 max-w-3xl scroll-mt-24">
      <h2 class="text-ink font-mono text-lg font-semibold">
        {pick(locale, title)}
      </h2>
      <p class="text-muted mt-3 leading-relaxed">{pick(locale, text)}</p>
      {links && (
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {links.map(({ href, label }) => (
            <li>
              <a class="link-accent" href={href}>
                {pick(locale, label)}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
  {aiNote && (
    <section id="ai-usage" class="panel mt-8 p-5">
      <h2 class="text-ink font-mono text-lg font-semibold">
        {locale === 'de' ? 'KI-Einsatz' : 'AI use'}
      </h2>
      <h3 class="text-ink mt-4 text-sm font-semibold">
        {locale === 'de' ? 'Entwicklung' : 'Development'}
      </h3>
      <p class="text-muted mt-3 leading-relaxed">
        {pick(locale, aiNote.development)}
      </p>
      <h3 class="text-ink mt-4 text-sm font-semibold">
        {locale === 'de' ? 'Produkt' : 'Product'}
      </h3>
      <p class="text-muted mt-3 leading-relaxed">
        {pick(locale, aiNote.product)}
      </p>
    </section>
  )}
  {story.provenance && (
    <aside class="border-line text-muted mt-8 border-l-2 pl-4 text-sm">
      {pick(locale, story.provenance)}{' '}
      {story.upstream && (
        <a
          href={story.upstream}
          target="_blank"
          rel="noopener"
          class="link-accent"
        >
          {t(locale, 'project.upstream')}
        </a>
      )}
    </aside>
  )}
  {story.diagram && (
    <section class="panel-lg mt-10">
      <>
        <h2 class="text-ink font-mono font-semibold">
          {pick(locale, story.diagram.title)}
        </h2>
        <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {story.diagram.steps.map((step, index) => (
            <li class="border-line bg-surface rounded-lg border p-4">
              <span aria-hidden="true" class="text-accent font-mono text-sm">
                {index + 1} →
              </span>
              <p class="text-ink mt-2 text-sm">{pick(locale, step)}</p>
            </li>
          ))}
        </ol>
      </>
    </section>
  )}
  {story.images && story.images.length > 0 && (
    <section class="mt-10">
      <>
        <h2 class="text-ink mb-5 font-mono text-lg font-semibold">
          {t(locale, 'project.screenshots')}
        </h2>
        <div class="grid items-start gap-6 md:grid-cols-2">
          {story.images.map(async (figure) => {
            const thumbnail = {
              src: figure.image,
              alt: pick(locale, figure.alt),
              widths: SCREENSHOT_WIDTHS,
              sizes: '(min-width: 768px) 45vw, 92vw',
              loading: 'lazy' as const,
              class: 'h-auto w-full',
            };
            const fullSize = linkScreenshots
              ? await getImage({
                  src: figure.image,
                  width: figure.image.width,
                  format: 'webp',
                })
              : undefined;
            return (
              <figure class="panel overflow-hidden">
                {fullSize ? (
                  <a
                    href={fullSize.src}
                    class="block cursor-zoom-in focus-visible:outline-offset-[-3px]"
                  >
                    <Image {...thumbnail} />
                    <span class="sr-only">
                      {t(locale, 'project.screenshots.open')}
                    </span>
                  </a>
                ) : (
                  <Image {...thumbnail} />
                )}
                <figcaption class="text-muted p-4 text-sm">
                  {pick(locale, figure.caption)}
                </figcaption>
              </figure>
            );
          })}
        </div>
      </>
    </section>
  )}
</article>
