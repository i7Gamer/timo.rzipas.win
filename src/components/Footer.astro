---
import {
  AUTHOR,
  EMAIL,
  GITHUB_URL,
  LINKEDIN_URL,
  REPO_URL,
} from '../data/site';
import { getLocale, t } from '../i18n';

const locale = getLocale();
const year = new Date().getFullYear();

const SHORT_SHA_LENGTH = 7;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA;
const shortSha = buildSha?.slice(0, SHORT_SHA_LENGTH);
const ICON_LINK_CLASS = 'text-muted hover:text-accent transition-colors';
---

<footer class="border-line border-t">
  <div
    class="text-muted max-w-page mx-auto flex w-full flex-col gap-4 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <div class="space-y-1">
      <p>© {year} {AUTHOR} · {t(locale, 'footer.selfHosted')}</p>
      <p class="font-mono text-xs">
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener"
          class="link-underline"
        >
          {t(locale, 'footer.source')}
        </a>
        {
          buildSha && (
            <>
              {' · '}
              {t(locale, 'footer.build')}{' '}
              <a
                href={`${REPO_URL}/commit/${buildSha}`}
                target="_blank"
                rel="noopener"
                class="link-underline"
              >
                {shortSha}
              </a>
            </>
          )
        }
      </p>
    </div>

    <ul class="flex items-center gap-4">
      <li>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener"
          data-no-arrow
          aria-label="GitHub"
          class={ICON_LINK_CLASS}
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            class="size-5"
          >
            <path
              d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.91c.58.11.79-.25.79-.55v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.53-1.32-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.75 2.7 1.25 3.35.95.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
            ></path>
          </svg>
        </a>
      </li>
      <li>
        <a
          href={LINKEDIN_URL}
          target="_blank"
          rel="noopener"
          data-no-arrow
          aria-label="LinkedIn"
          class={ICON_LINK_CLASS}
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            class="size-5"
          >
            <path
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z"
            ></path>
          </svg>
        </a>
      </li>
      <li>
        <a
          href={`mailto:${EMAIL}`}
          aria-label={t(locale, 'a11y.email')}
          class={ICON_LINK_CLASS}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="size-5"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </a>
      </li>
    </ul>
  </div>
</footer>
