---
import { AUTHOR, REPO_URL } from '../data/site';
import { getLocale, t } from '../i18n';
import SocialLinks from './SocialLinks.astro';

const locale = getLocale();
const year = new Date().getFullYear();

const SHORT_SHA_LENGTH = 7;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA;
const shortSha = buildSha?.slice(0, SHORT_SHA_LENGTH);
---

<footer class="border-line border-t">
  <div class="text-muted max-w-page mx-auto flex w-full flex-col gap-4 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div class="space-y-1">
      <p>
        © {year} {AUTHOR} · {t(locale, 'footer.selfHosted')}
      </p>
      <p class="font-mono text-xs">
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener"
          class="link-underline"
        >
          {t(locale, 'footer.source')}
        </a>
        {buildSha && (
          <>
            {' · '}
            {t(locale, 'footer.build')}{' '}
            <a
              href={`${REPO_URL}/commit/${buildSha}`}
              target="_blank"
              rel="noopener"
              class="link-underline"
            >
              {shortSha}
            </a>
          </>
        )}
      </p>
    </div>

    <SocialLinks locale={locale} />
  </div>
</footer>
