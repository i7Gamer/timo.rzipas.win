---
import { HOME_HREF, NAV } from '../data/routes';
import { getLocale, t } from '../i18n';
import { isActivePath, isSectionPath } from '../lib/paths';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

const locale = getLocale();
const currentPath = Astro.url.pathname;
const navItems = NAV.map(({ href, labelKey }) => ({
  href,
  label: t(locale, labelKey),
  active: isActivePath(currentPath, href),
  inSection: isSectionPath(currentPath, href),
}));
---

<header class="border-line bg-surface/90 sticky top-0 z-10 border-b backdrop-blur">
  <div class="max-w-page mx-auto flex w-full items-center justify-between gap-2 px-4 py-3 sm:gap-3 sm:px-6">
    <a
      href={HOME_HREF}
      class="text-ink hover:text-accent shrink-0 font-mono text-sm font-semibold transition-colors"
    >
      <span class="text-accent">~</span>/timo
    </a>

    <nav
      aria-label={t(locale, 'a11y.mainNav')}
      class="-my-1.5 hidden items-center gap-0.5 py-1.5 min-[400px]:flex sm:gap-1"
    >
      {navItems.map(({ href, label, active, inSection }) => (
        <a
          href={href}
          aria-current={active ? 'page' : inSection ? 'location' : undefined}
          class:list={[
            'shrink-0 rounded-md px-1.5 py-1 text-xs whitespace-nowrap transition-colors sm:px-3 sm:text-sm',
            inSection ? 'text-accent font-medium' : 'text-muted hover:text-ink',
            href === HOME_HREF && 'hidden sm:inline-block',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>

    <details class="relative min-[400px]:hidden">
      <summary class="btn-muted flex cursor-pointer list-none items-center gap-2 [&::-webkit-details-marker]:hidden">
        {t(locale, 'nav.menu')} <span aria-hidden="true">▾</span>
      </summary>
      <nav
        aria-label={t(locale, 'a11y.mainNav')}
        class="panel absolute top-full left-1/2 z-10 mt-2 min-w-36 -translate-x-1/2 p-1"
      >
        {navItems
          .filter(({ href }) => href !== HOME_HREF)
          .map(({ href, label, active, inSection }) => (
            <a
              href={href}
              aria-current={
                active ? 'page' : inSection ? 'location' : undefined
              }
              class:list={[
                'hover:bg-accent-soft block rounded-md px-3 py-2 text-sm whitespace-nowrap',
                inSection ? 'text-accent font-medium' : 'text-ink',
              ]}
            >
              {label}
            </a>
          ))}
      </nav>
    </details>

    <div class="flex shrink-0 items-center gap-2">
      <LanguageSwitcher />
      <ThemeToggle />
    </div>
  </div>
</header>
