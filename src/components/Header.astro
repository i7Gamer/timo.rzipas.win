---
import { HOME_HREF, NAV } from '../data/routes';
import { getLocale, t } from '../i18n';
import { isActivePath } from '../lib/paths';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

const locale = getLocale();
const currentPath = Astro.url.pathname;
---

<header
  class="border-line bg-surface/90 sticky top-0 z-10 border-b backdrop-blur"
>
  <div
    class="max-w-page mx-auto flex w-full items-center justify-between gap-2 px-4 py-3 sm:gap-3 sm:px-6"
  >
    <a
      href={HOME_HREF}
      class="text-ink hover:text-accent shrink-0 font-mono text-sm font-semibold transition-colors"
    >
      <span class="text-accent">~</span>/timo
    </a>

    <nav
      aria-label={t(locale, 'a11y.mainNav')}
      class="-my-1.5 flex min-w-0 scrollbar-none items-center gap-0.5 overflow-x-auto py-1.5 sm:gap-1"
    >
      {
        NAV.map((item) => {
          const active = isActivePath(currentPath, item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'shrink-0 rounded-md px-1.5 py-1 text-xs whitespace-nowrap transition-colors sm:px-3 sm:text-sm',
                active
                  ? 'text-accent font-medium'
                  : 'text-muted hover:text-ink',
                item.href === HOME_HREF && 'hidden sm:inline-block',
              ]}
            >
              {t(locale, item.labelKey)}
            </a>
          );
        })
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <LanguageSwitcher />
      <ThemeToggle />
    </div>
  </div>
</header>
