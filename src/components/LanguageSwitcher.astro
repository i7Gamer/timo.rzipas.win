---
import { getLocale, nextLocale, t } from '../i18n';

const locale = getLocale();
const target = nextLocale(locale);
---

<button
  type="button"
  data-lang-switch
  data-target={target}
  aria-label={t(locale, 'lang.switch.label')}
  class="border-line text-muted hover:border-accent hover:text-accent grid h-9 min-w-9 place-items-center rounded-md border px-1.5 font-mono text-xs font-semibold transition-colors"
>
  {t(locale, 'lang.switch.code')}
</button>

<script>
  import {
    LANG_COOKIE_MAX_AGE_SECONDS,
    LANG_COOKIE_NAME,
  } from '../i18n/cookie';

  document
    .querySelectorAll<HTMLButtonElement>('[data-lang-switch]')
    .forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.dataset.target;
        if (!target) {
          return;
        }
        document.cookie = `${LANG_COOKIE_NAME}=${target}; path=/; max-age=${LANG_COOKIE_MAX_AGE_SECONDS}; SameSite=Lax`;
        window.location.reload();
      });
    });
</script>
