---
import { pick, t, type Locale } from '../i18n';
import type { Project } from '../lib/projects';
import { projectHref } from '../lib/projects';

interface Props {
  project: Project;
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
}

const { project, locale } = Astro.props;
const Heading = Astro.props.headingLevel ?? 'h3';

const BADGE_CLASS =
  'rounded-full border px-2 py-0.5 font-mono text-[11px] whitespace-nowrap';
const STATUS_STYLES: Record<Project['status'], string> = {
  active: 'border-accent/40 bg-accent-soft text-accent',
  archived: 'border-line bg-surface text-muted',
};
const FORK_STYLE = 'border-amber-500/40 bg-fork-soft text-fork';
const statusKey = `project.status.${project.status}` as const;
---

<article
  class="panel hover:border-accent/60 flex h-full flex-col gap-3 p-5 transition-colors"
>
  <div class="flex items-start justify-between gap-3">
    <Heading class="text-ink font-mono text-base font-semibold"
      >{project.name}</Heading
    >
    <div class="flex flex-wrap justify-end gap-1.5">
      {
        project.fork && (
          <span class:list={[BADGE_CLASS, FORK_STYLE]}>
            {t(locale, 'project.status.fork')}
          </span>
        )
      }
      <span class:list={[BADGE_CLASS, STATUS_STYLES[project.status]]}>
        {t(locale, statusKey)}
      </span>
    </div>
  </div>
  <p class="text-ink text-sm font-medium">{pick(locale, project.tagline)}</p>
  <p class="text-muted flex-1 text-sm">{pick(locale, project.description)}</p>
  <ul class="flex flex-wrap gap-1.5">
    {
      project.tech.map((tag) => (
        <li class="chip bg-surface text-muted">{tag}</li>
      ))
    }
  </ul>
  {
    (project.story || project.repo || project.link) && (
      <div data-project-actions class="flex flex-wrap gap-4 pt-1">
        {project.story && (
          <a href={projectHref(project.slug)} class="link-accent text-xs">
            {t(locale, 'project.details')} →
          </a>
        )}
        {project.repo && (
          <a
            href={project.repo}
            target="_blank"
            rel="noopener"
            class="link-accent text-xs"
          >
            {t(locale, 'project.source')}
          </a>
        )}
        {project.link && (
          <a
            href={project.link}
            target="_blank"
            rel="noopener"
            class="link-accent text-xs"
          >
            {t(locale, 'project.visit')}
          </a>
        )}
      </div>
    )
  }
</article>
