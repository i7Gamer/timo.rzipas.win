---
import type { Service } from '../data/services';
import { pick, t, type Locale } from '../i18n';
import { STATUS_DOT_CLASS } from '../lib/status';

interface Props {
  service: Service;
  locale: Locale;
  headingLevel?: 'h3' | 'h4';
}

const { service, locale } = Astro.props;
const Heading = Astro.props.headingLevel ?? 'h3';

const initialStatus = service.status === 'planned' ? 'planned' : 'unknown';
const statusKey = `status.${initialStatus}` as const;
---

<article
  data-service={service.name}
  data-planned={service.status === 'planned' ? 'true' : undefined}
  class="panel flex h-full flex-col gap-2 p-4"
>
  <div class="flex items-center justify-between gap-2">
    <Heading class="text-ink font-mono text-sm font-semibold"
      >{service.name}</Heading
    >
    <span class="text-muted flex items-center gap-1.5 font-mono text-[11px]">
      <span
        aria-hidden="true"
        data-status-dot
        class:list={['size-1.5 rounded-full', STATUS_DOT_CLASS[initialStatus]]}
      ></span>
      <span data-status-label>{t(locale, statusKey)}</span>
    </span>
  </div>
  <span class="chip bg-surface text-muted w-fit">
    {pick(locale, service.category)}
  </span>
  <p class="text-muted text-sm">{pick(locale, service.description)}</p>
</article>
